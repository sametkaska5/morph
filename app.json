{
  "expo": {
    "name": "Remory",
    "slug": "remory",
    "scheme": "remory",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A08",
    "icon": "./assets/images/icon.png",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Karşılaştırma görsellerini galerine kaydedebilmek için fotoğraflarına erişim gerekiyor.",
          "savePhotosPermission": "Karşılaştırma görsellerini galerine kaydedebilmek için fotoğraflarına erişim gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Anılarını fotoğraflayabilmek için kameraya erişim gerekiyor.",
          "photosPermission": "Galerinden fotoğraf seçebilmek için galeriye erişim gerekiyor.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A08"
        }
      ],
      "@sentry/react-native"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.remory.app"
    },
    "android": {
      "package": "com.remory.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A08"
      }
    }
  }
}
