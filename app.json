{
  "expo": {
    "name": "Morph",
    "slug": "remory",
    "scheme": "remory",
    "version": "0.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A08",
    "icon": "./assets/images/icon.png",
    "updates": {
      "url": "https://u.expo.dev/2131b708-cd8d-4e16-bce0-febe12619e10"
    },

    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Karsilastirma gorsellerini galerine kaydedebilmek icin fotograflarina erisim gerekiyor.",
          "savePhotosPermission": "Karsilastirma gorsellerini galerine kaydedebilmek icin fotograflarina erisim gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Anilarini fotograflayabilmek icin kameraya erisim gerekiyor.",
          "photosPermission": "Galerinden fotograf secebilmek icin galeriye erisim gerekiyor.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8CE05A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A08"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "extraParams": [
              {
                "key": "org.gradle.jvmargs",
                "value": "-Xmx4096m -XX:MaxMetaspaceSize=1024m"
              }
            ]
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.remory.app"
    },
    "android": {
      "package": "com.remory.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A08"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2131b708-cd8d-4e16-bce0-febe12619e10"
      }
    },
    "owner": "parzival55s-team"
  }
}
