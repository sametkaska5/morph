{
  "name": "remory",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{app,components,lib}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{app,components,lib}/**/*.{ts,tsx}\"",
    "gen:types": "supabase gen types typescript --linked --schema public > lib/database.types.ts"
  },
  "//expo": "Bu üç paketin native tarafı telefondaki Expo Go APK'sine gömülü ve npm ile değiştirilemiyor. JS sürümünü yükseltmek uygulamayı açılışta çökertiyor (worklets JS/Babel sürüm uyuşmazlığı) — iki kez yaşandı. `expo install` uyumluluk için yükseltme önerse bile bu projede DOKUNULMAMALI; exclude listesi bunu kalıcı hale getiriyor. Yükseltmek gerekirse önce development build'e geçilmeli.",
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets",
        "react-native-reanimated",
        "react-native"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.43.0",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.40.0",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.6",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-media-library": "~57.0.3",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.12",
    "jest-expo": "~57.0.2",
    "nativewind": "^4.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
