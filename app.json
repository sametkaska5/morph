{
  "expo": {
    "name": "Remory",
    "slug": "remory",
    "scheme": "remory",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A08",
    "icon": "./assets/images/icon.png",
    "updates": {
      "url": "https://u.expo.dev/2131b708-cd8d-4e16-bce0-febe12619e10"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Karşılaştırma görsellerini galerine kaydedebilmek için fotoğraflarına erişim gerekiyor.",
          "savePhotosPermission": "Karşılaştırma görsellerini galerine kaydedebilmek için fotoğraflarına erişim gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Anılarını fotoğraflayabilmek için kameraya erişim gerekiyor.",
          "photosPermission": "Galerinden fotoğraf seçebilmek için galeriye erişim gerekiyor.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8CE05A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A08"
        }
      ],
      "@sentry/react-native"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.remory.app"
    },
    "android": {
      "package": "com.remory.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A08"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2131b708-cd8d-4e16-bce0-febe12619e10"
      }
    },
    "owner": "parzival55"
  }
}
