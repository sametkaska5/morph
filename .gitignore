node_modules/
.env

# Sentry kaynak haritası yükleyicisinin okuduğu token dosyası
# (@sentry/react-native/scripts/expo-upload-sourcemaps.js, projeye kökünden bakıyor).
# Üstteki `.env` kalıbı bunu KAPSAMIYOR — gitignore'da `.env` yalnızca tam adı
# `.env` olan dosyayı tutuyor. Ayrıca yazılmazsa `git add -A` token'ı public
# repoya sokuyor.
.env.sentry-build-plugin

# Expo'nun yerel çalışma klasörü: makineye özel (devices.json, sunucu ayarları,
# CLI logları) ve ESLint önbelleği burada tutuluyor — takip edilirse her lint
# çalıştırmasında sahte diff üretiyor. Expo'nun kendi şablonu da bu klasörün
# tamamını yoksayar (bkz. .expo/README.md).
.expo/

# graphify: bilgi grafiğinin ÇIKTILARI (graph.json, graph.html, GRAPH_REPORT.md,
# manifest.json, .graphify_labels.json) bilerek takip ediliyor — grafiği yeniden
# kurmadan sorgulanabilsinler diye. Aşağıdakiler ise takip EDİLMEMELİ: iki durum
# dosyası bu makinenin mutlak yollarını (Python yorumlayıcısı, proje kökü)
# içeriyor, cache yeniden üretilebilir, cost.json kişisel token harcaması.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/
graphify-out/cost.json

# `eas update`in yayınlamadan önce ürettiği paket (JS bundle + tüm asset'ler,
# ~50 MB). Tamamen üretilebilir bir çıktı ve her güncellemede baştan yazılıyor —
# takip edilirse her `eas update` sonrası devasa ve anlamsız bir diff çıkıyor.
dist/

# Supabase CLI'ın `link` sonrası bıraktığı yerel durum: bağlı proje referansı,
# pooler bağlantı adresi ve uzak sunucudan okunan sürüm bilgileri. Makineye ve
# o anki bağlantıya özel, üretilebilir — migration'lar (takip EDİLEN kısım)
# supabase/migrations/ altında.
supabase/.temp/
